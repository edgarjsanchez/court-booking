# Copy this file to ".env" and fill in the values from the Neon Console.
# Leave .env out entirely to run in demo mode (no database, sample players).

# Neon Console → your project → Dashboard → Connect → copy the connection string
# (pooled is fine). Keep this secret: never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Console → your project → Auth → Configuration → "Auth Base URL".
# Same value twice: one for the API server, one for the browser.
NEON_AUTH_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth
